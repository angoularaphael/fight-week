# Fight and Furious - variables d'environnement (placeholders uniquement).
# Valeurs reelles : tableau de bord Vercel (option Sensitive), jamais ici.

PUBLIC_SITE_URL=https://gala.boxingcenter.fr
# test ou live
GALA_PAYMENT_MODE=test
# 1 = vente ouverte (sinon liste d'attente)
GALA_SALES_OPEN=0

# Supabase (projet dedie au gala) : Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secrets internes (32 octets aleatoires chacun, differents entre eux)
POW_SECRET=change-me-in-dev
RATE_SALT=change-me-in-dev
TICKET_HMAC_SECRET=change-me-in-dev
TICKET_HMAC_KID=1
# Rotation : ancienne cle acceptee au scan pendant la transition
TICKET_HMAC_SECRET_PREVIOUS=
TICKET_HMAC_KID_PREVIOUS=
CRON_SECRET=change-me-in-dev
# Difficulte PoW en bits (12 a 22)
POW_BITS=16

# PayPlug compte Boxing Center
PAYPLUG_SECRET_KEY=
PAYPLUG_TEST_SECRET_KEY=

# PayPal compte Boxing Center (pas de compte Portet)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_CLIENT_SECRET=
PAYPAL_TEST_WEBHOOK_ID=

# Brevo suzinabot (meme cle que BOXPLUS / boutique)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=sender@example.com
BREVO_SENDER_NAME=Fight and Furious
BREVO_REPLY_TO=contact@example.com

PUBLIC_GSC_VERIFICATION=
