---
import '@fontsource-variable/jost/wght.css';
import '@fontsource/michroma/400.css';
import '../styles/site.css';
import { SITE } from '../../lib/event.js';
import { baseGraph } from '../data/seo.js';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = '/img/og-fight-and-furious.jpg',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  jsonLd = baseGraph(),
  theme = 'dark',
  referrer = 'strict-origin-when-cross-origin',
} = Astro.props;

const url = path === '/' ? SITE.url : SITE.url + path.replace(/\/$/, '');
const imageUrl = ogImage.startsWith('http') ? ogImage : SITE.url + ogImage;
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
---

<!doctype html>
<html lang="fr" class="no-js" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.remove("no-js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.organizer} />
    <meta name="referrer" content={referrer} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="fr-FR" href={url} />
    <link rel="alternate" hreflang="x-default" href={url} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta http-equiv="content-language" content="fr-FR" />
    <meta name="theme-color" content="#141414" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fight and Furious, gala Boxing Center x MOTEKA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <SiteHeader />
    <main id="contenu">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/reveal.js';
    </script>
  </body>
</html>
