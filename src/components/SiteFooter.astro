---
import { SITE, VENUE } from '../../lib/event.js';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brands">
      <img src="/brand/boxing-center-blanc.png" alt="Boxing Center" width="214" height="100" loading="lazy" class="bc-chip" />
      <span class="x" aria-hidden="true">x</span>
      <img src="/brand/moteka-logo-blanc.svg" alt="MOTEKA" width="180" height="22" loading="lazy" />
    </div>
    <p class="muted">
      {SITE.name}, 11 au 13 décembre 2026.<br />
      {VENUE.name}, {VENUE.street}, {VENUE.postalCode} {VENUE.city}.
    </p>
    <p class="muted" style="font-size:13px">Voiture 3D : Car Concept, Khronos Group, licence CC BY 4.0.</p>
    <nav class="footer-links" aria-label="Liens utiles">
      <a href="/billetterie">Billetterie</a>
      <a href="https://fight-and-furious.boxingcenter.fr/?src=gal#concours" rel="noopener">Jeu concours FIGHT &amp; Furious</a>
      <a href="https://boutique.boxingcenter.fr/billetterie?src=gal" rel="noopener">Billets boutique</a>
      <a href="/billetterie#renvoi">Renvoyer mes billets</a>
      <a href="/recherche">Recherche</a>
      <a href="/cgv">Conditions de vente</a>
      <a href="/mentions-legales">Mentions légales</a>
      <a href={`mailto:${SITE.contactEmail}`}>Contact</a>
    </nav>
  </div>
</footer>
